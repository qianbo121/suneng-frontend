# 生产数据库密码。示例：DB_PASSWORD=请替换为强密码
DB_PASSWORD=please_change_database_password

# 后台 JWT 签名密钥。示例：JWT_SECRET=一段至少32位的随机字符串
JWT_SECRET=please_change_jwt_secret_at_least_32_chars

# 官网主域名，不要带 http/https。示例：DOMAIN=www.sunengfurnace.com
DOMAIN=www.example.com

# 后台管理域名，不要带 http/https。示例：ADMIN_DOMAIN=admin.sunengfurnace.com
ADMIN_DOMAIN=admin.example.com

# 数炬桌面端入口必须指向的正式公网 IP。部署脚本会与 DNS 实际解析严格比对。
SHUJU_EXPECTED_PUBLIC_IP=

# JWT 有效期，默认 7d。示例：JWT_EXPIRES_IN=7d
JWT_EXPIRES_IN=7d

# 单文件上传大小限制，单位 MB，默认 10。示例：UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_MAX_FILE_SIZE_MB=10

# 后台登录最大失败次数，默认 5。示例：ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_MAX_ATTEMPTS=5

# 后台登录失败锁定时间，单位分钟，默认 15。示例：ADMIN_LOGIN_LOCK_MINUTES=15
ADMIN_LOGIN_LOCK_MINUTES=15

# 数炬只读服务默认关闭。启用时必须使用一把独立于后台 JWT 的随机密钥。
SHUJU_SERVICE_ENABLED=false
SHUJU_SERVICE_JWT_SECRET=
# 独立写信任域；必须与后台JWT和只读密钥都不同。首次真实发布批准前保持false。
SHUJU_NEWS_PUBLISH_ENABLED=false
SHUJU_NEWS_PUBLISH_JWT_SECRET=

# 站点对外规范域名（含 https），用于 canonical / sitemap / SEO。
# 未设置时后端回退到内置默认值，不会导致启动失败。
PUBLIC_SITE_URL=https://www.example.com

# 百度站长推送（可选，不配则不推送）。
BAIDU_SITE=
BAIDU_TOKEN=

# ---- 搜索收录与统计（下面六项不填，站长后台就验证不了、统计也不会上报）----
# 四个站长平台的验证码。到各自后台「添加网站 → HTML 标签验证」里复制 content 的值，
# 只填引号里的那串，不要带 <meta>。填完必须重新构建前端镜像才会出现在页面 head 里
# （NEXT_PUBLIC_* 是构建期注入的）。
NEXT_PUBLIC_BAIDU_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_360_SITE_VERIFICATION=
NEXT_PUBLIC_SOGOU_SITE_VERIFICATION=

# 百度统计的站点 id（tongji.baidu.com → 代码获取，hm.js?后面那串）。
# 不填则页面不加载统计脚本。同样需要重新构建。
NEXT_PUBLIC_BAIDU_APP_ID=

# IndexNow 所有权证明密钥，必须与仓库 secret INDEXNOW_KEY 完全一致；
# 前端用它对外提供 /indexnow-key.txt，不一致或缺失时该地址返回 404，提交会被拒。
INDEXNOW_KEY=

# 上线前若要临时全站禁止收录，设为 true（正式对外必须保持 false）。
SITE_NOINDEX=false

# 官网新询盘飞书群机器人 Webhook（可选）。配置后，询盘入库成功会发送群通知。
FEISHU_INQUIRY_WEBHOOK_URL=

# 说明：DATABASE_URL / ALLOWED_ORIGINS / FRONTEND_URL / ADMIN_URL 由
# docker-compose.prod.yml 依据上面的 DB_PASSWORD / DOMAIN / ADMIN_DOMAIN 自动拼装，
# 无需在本文件单独设置（生产环境这几项缺失会被 configuration.ts 守卫拦下）。
