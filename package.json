{
  "name": "manufacturing-corporate-site",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "brace-expansion@1.1.14": "1.1.18",
      "brace-expansion@2.1.0": "2.1.4",
      "brace-expansion@5.0.5": "5.0.9",
      "browserslist": "4.28.7",
      "deepmerge-ts@7.1.5": "8.0.1",
      "fast-uri": "3.1.6",
      "js-yaml": "5.2.2",
      "nanoid@3.3.17": "3.3.18",
      "postcss": "8.5.23",
      "qs": "6.16.0",
      "sharp": "0.35.4",
      "multer": "2.3.0",
      "postcss-selector-parser@6.1.2": "6.1.3"
    }
  },
  "scripts": {
    "dev:frontend": "pnpm --dir frontend dev",
    "dev:backend": "pnpm --dir backend start:dev",
    "dev:admin": "pnpm --dir admin dev",
    "build:frontend": "pnpm --dir frontend build",
    "build:backend": "pnpm --dir backend build",
    "build:admin": "pnpm --dir admin build",
    "build": "pnpm -r build",
    "lint:frontend": "pnpm --dir frontend lint",
    "lint:backend": "pnpm --dir backend lint",
    "lint:admin": "pnpm --dir admin lint",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:visual": "pnpm --dir frontend test:visual",
    "test:visual:update": "pnpm --dir frontend test:visual:update",
    "check:workpiece-router": "node scripts/validate-workpiece-router.mjs --mode=build",
    "check:workpiece-router:schema": "node scripts/validate-workpiece-router.mjs --mode=schema",
    "check:workpiece-router:publication": "node scripts/validate-workpiece-router.mjs --mode=publication",
    "export:workpiece-router-review": "node scripts/export-workpiece-rule-review.mjs",
    "check:secrets": "bash scripts/check-no-secrets.sh",
    "format": "pnpm --dir frontend format && pnpm --dir backend format && pnpm --dir admin format",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  }
}
