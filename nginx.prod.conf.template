worker_processes auto;

error_log /var/log/nginx/error.log warn;
error_log stderr warn;

events {
  worker_connections 1024;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;

  log_format analytics_json escape=json
    '{"time":"$time_iso8601",'
    '"request_id":"$request_id",'
    '"host":"$host",'
    '"server_name":"$server_name",'
    '"remote_addr":"$remote_addr",'
    '"method":"$request_method",'
    '"uri":"$uri",'
    '"protocol":"$server_protocol",'
    '"status":$status,'
    '"request_length":$request_length,'
    '"body_bytes_sent":$body_bytes_sent,'
    '"request_time":$request_time,'
    '"upstream_status":"$upstream_status",'
    '"upstream_response_time":"$upstream_response_time",'
    '"cache_status":"$upstream_cache_status",'
    '"crawler_family":"$crawler_family",'
    '"monitoring_probe":"$monitoring_probe",'
    '"lead_event":"$lead_event",'
    '"referer":"$http_referer",'
    '"user_agent":"$http_user_agent"}';

  map $http_user_agent $crawler_family {
    default "";
    ~*OAI-SearchBot "openai_oai_searchbot";
    ~*ChatGPT-User "openai_chatgpt_user";
    ~*GPTBot "openai_gptbot";
    ~*Claude-SearchBot "anthropic_claude_searchbot";
    ~*Claude-User "anthropic_claude_user";
    ~*ClaudeBot "anthropic_claudebot";
    ~*Perplexity-User "perplexity_user";
    ~*PerplexityBot "perplexity_bot";
    ~*Bytespider "bytedance_bytespider";
    ~*Baiduspider "baidu_spider";
    ~*Sogou "sogou_spider";
    ~*360Spider "360_spider";
    ~*YisouSpider "yisou_spider";
    ~*Googlebot "googlebot";
    ~*bingbot "bingbot";
  }

  map $http_x_suneng_monitoring_probe $monitoring_probe {
    default "";
    ~*^crawler-verification$ "crawler_verification";
  }

  map "$request_method:$uri" $lead_event {
    default "";
    ~^POST:/api/v1/custom-requirements/?$ "custom_requirement_submit";
    ~^POST:/api/v1/lead-events/?$ "lead_event_ingest";
  }

  access_log /var/log/nginx/other.access.json analytics_json;

  sendfile on;
  tcp_nopush on;
  tcp_nodelay on;
  keepalive_timeout 65;
  server_tokens off;
  types_hash_max_size 2048;
  client_max_body_size 20m;

  gzip on;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_proxied any;
  gzip_types
    text/plain
    text/css
    text/xml
    application/json
    application/javascript
    application/xml+rss
    application/xml
    image/svg+xml;

  proxy_cache_path /var/cache/nginx/news
    levels=1:2
    keys_zone=news_cache:10m
    inactive=10m
    max_size=100m
    use_temp_path=off;

  # Shared, multi-instance protection for the public inquiry endpoint. The
  # application keeps a bounded in-process fallback as a second line of defense.
  limit_req_zone $binary_remote_addr zone=inquiry_submit:10m rate=5r/m;
  # Shuju also has a persistent per-account lock. This edge zone adds a
  # separate per-IP boundary before password verification reaches the app.
  limit_req_zone $binary_remote_addr zone=shuju_login:10m rate=5r/m;
  resolver 127.0.0.11 valid=10s ipv6=off;

  upstream frontend_upstream {
    server frontend:3000;
  }

  upstream backend_upstream {
    server backend:3001;
  }

  upstream admin_upstream {
    server admin:80;
  }

  # Chengwen is deployed independently but shares this edge proxy. Keep this
  # upstream and both virtual hosts in the checked-in template so a website
  # deployment cannot silently remove the live route.
  upstream chengwen_upstream {
    server chengwen-web:8080;
  }

  # Shuju remains loopback-only on the host. The shared edge reaches it only
  # through website_default using Docker DNS.
  upstream shuju_upstream {
    zone shuju_upstream 64k;
    server shuju:18321 resolve;
    keepalive 16;
  }

  # 数炬引擎：桌面端工作台。账号、会话和业务库与智能工厂完全独立。
  server {
    listen 80;
    server_name shuju.jssngyl.cn;
    access_log /var/log/nginx/shuju.access.json analytics_json;
    error_log /var/log/nginx/shuju.error.log warn;

    location /.well-known/acme-challenge/ {
      root /var/www/certbot;
    }

    location / {
      return 301 https://$host$request_uri;
    }
  }

  server {
    listen 443 ssl;
    http2 on;
    server_name shuju.jssngyl.cn;
    access_log /var/log/nginx/shuju.access.json analytics_json;
    error_log /var/log/nginx/shuju.error.log warn;

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    client_max_body_size 11m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Cache-Control "no-store" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;

    # Executor writes and detailed readiness stay on Docker/loopback only.
    location = /api/internal {
      return 404;
    }

    location ^~ /api/internal/ {
      return 404;
    }

    location = /api/ready {
      return 404;
    }

    location = /api/auth/login {
      limit_req zone=shuju_login burst=3 nodelay;
      limit_req_status 429;
      limit_req_log_level notice;
      client_max_body_size 32k;
      proxy_pass http://shuju_upstream;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Request-ID $request_id;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_connect_timeout 3s;
      proxy_send_timeout 15s;
      proxy_read_timeout 30s;
      proxy_no_cache 1;
      proxy_cache_bypass 1;
    }

    location / {
      proxy_pass http://shuju_upstream;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header X-Request-ID $request_id;
      proxy_set_header X-Real-IP $remote_addr;
      # Do not preserve a client-supplied forwarding chain.
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_connect_timeout 3s;
      proxy_send_timeout 30s;
      proxy_read_timeout 60s;
      proxy_no_cache 1;
      proxy_cache_bypass 1;
    }
  }

  # 智能工厂系统：独立子域名，同源代理前端与 API。
  server {
    listen 80;
    server_name factory.jssngyl.cn;
    access_log /var/log/nginx/factory.access.json analytics_json;

    location /.well-known/acme-challenge/ {
      root /var/www/certbot;
    }

    location / {
      return 301 https://$host$request_uri;
    }
  }

  server {
    listen 443 ssl;
    http2 on;
    server_name factory.jssngyl.cn;
    access_log /var/log/nginx/factory.access.json analytics_json;

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    client_max_body_size 100m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;

    location /api/ {
      proxy_pass http://furnace-api:18080/;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
      proxy_pass http://furnace-web:80;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
    }
  }

  # 成文 AI：独立子域名，代理到单独部署的应用容器。
  server {
    listen 80;
    server_name chengwen.jssngyl.cn;

    location /.well-known/acme-challenge/ {
      root /var/www/certbot;
    }

    location / {
      return 301 https://$host$request_uri;
    }
  }

  server {
    listen 443 ssl;
    http2 on;
    server_name chengwen.jssngyl.cn;

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;

    location / {
      proxy_pass http://chengwen_upstream;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }
  }

  server {
    listen 80;
    server_name jssngyl.cn ${DOMAIN};
    access_log /var/log/nginx/redirect.access.json analytics_json;

    # 兼容旧版智能工厂工时二维码，保留令牌路径并切到正确子域名。
    location ^~ /h5/work-scan/ {
      return 302 https://factory.jssngyl.cn$request_uri;
    }

    # 组织架构子页面已并入公司简介，301 重定向
    location = /zh/about/organization {
      return 301 https://www.jssngyl.cn/zh/about;
    }

    location = /en/about/organization {
      return 301 https://www.jssngyl.cn/en/about;
    }

    location /.well-known/acme-challenge/ {
      root /var/www/certbot;
    }

    location = /product/showproduct.php {
      return 301 https://www.jssngyl.cn/zh/products;
    }

    location = /product/product.php {
      return 301 https://www.jssngyl.cn/zh/products;
    }

    location = /news/shownews.php {
      return 301 https://www.jssngyl.cn/zh/news;
    }

    location = /news/news.php {
      return 301 https://www.jssngyl.cn/zh/news;
    }

    location ~ \.php$ {
      return 301 https://www.jssngyl.cn/zh;
    }

    location / {
      return 301 https://www.jssngyl.cn$request_uri;
    }
  }

  server {
    listen 80;
    server_name ${ADMIN_DOMAIN};
    access_log /var/log/nginx/admin.access.json analytics_json;

    location /.well-known/acme-challenge/ {
      root /var/www/certbot;
    }

    location / {
      return 301 https://$host$request_uri;
    }
  }

  server {
    listen 443 ssl;
    http2 on;
    server_name jssngyl.cn;
    access_log /var/log/nginx/redirect.access.json analytics_json;

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # 兼容旧版智能工厂工时二维码，保留令牌路径并切到正确子域名。
    location ^~ /h5/work-scan/ {
      return 302 https://factory.jssngyl.cn$request_uri;
    }

    # 组织架构子页面已并入公司简介，301 重定向
    location = /zh/about/organization {
      return 301 https://www.jssngyl.cn/zh/about;
    }

    location = /en/about/organization {
      return 301 https://www.jssngyl.cn/en/about;
    }

    location = /product/showproduct.php {
      return 301 https://www.jssngyl.cn/zh/products;
    }

    location = /product/product.php {
      return 301 https://www.jssngyl.cn/zh/products;
    }

    location = /news/shownews.php {
      return 301 https://www.jssngyl.cn/zh/news;
    }

    location = /news/news.php {
      return 301 https://www.jssngyl.cn/zh/news;
    }

    location ~ \.php$ {
      return 301 https://www.jssngyl.cn/zh;
    }

    location / {
      return 301 https://www.jssngyl.cn$request_uri;
    }
  }

  server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};
    access_log /var/log/nginx/www.access.json analytics_json;

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    # Enforce a conservative baseline while allowing the current Next.js runtime
    # script/style requirements. Tighten unsafe-inline/unsafe-eval after report
    # telemetry confirms the runtime no longer needs them.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://hm.baidu.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://www.jssngyl.cn https://admin.jssngyl.cn https://hm.baidu.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests" always;

    # 兼容旧版智能工厂工时二维码，保留令牌路径并切到正确子域名。
    location ^~ /h5/work-scan/ {
      return 302 https://factory.jssngyl.cn$request_uri;
    }

    # 组织架构子页面已并入公司简介，301 重定向
    location = /zh/about/organization {
      return 301 https://www.jssngyl.cn/zh/about;
    }

    location = /en/about/organization {
      return 301 https://www.jssngyl.cn/en/about;
    }

    location ^~ /api/admin/ {
      return 403;
    }

    # Service-to-service routes are reachable only on the Docker network by
    # calling the backend directly. Never proxy them from the public website.
    location ^~ /api/svc/ {
      return 404;
    }

    location = /product/showproduct.php {
      return 301 /zh/products;
    }

    location = /product/product.php {
      return 301 /zh/products;
    }

    location = /news/shownews.php {
      return 301 /zh/news;
    }

    location = /news/news.php {
      return 301 /zh/news;
    }

    location ~ \.php$ {
      return 301 /zh;
    }

    # Keep the public root deterministic for crawlers. Locale-prefixed URLs
    # remain the canonical language entry points; English stays available at /en.
    location = / {
      return 308 https://$DOMAIN/zh;
    }

    location = /api/v1/news {
      proxy_cache news_cache;
      proxy_cache_valid 200 5m;
      proxy_cache_key "$scheme$request_method$host$request_uri";
      add_header X-Cache-Status $upstream_cache_status always;

      proxy_pass http://backend_upstream;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/v1/custom-requirements {
      limit_req zone=inquiry_submit burst=2 nodelay;
      limit_req_status 429;
      proxy_pass http://backend_upstream;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/v1/custom-requirements/ {
      limit_req zone=inquiry_submit burst=2 nodelay;
      limit_req_status 429;
      proxy_pass http://backend_upstream;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /api/v1/ {
      proxy_pass http://backend_upstream;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Force svg/pdf to download (never render inline) so a stored file cannot
    # execute script in the user's origin. Regex locations are matched before
    # the /uploads/ prefix, so raster images below stay inline as before.
    location ~* ^/uploads/(?<upload_asset>.+\.(?:svg|pdf))$ {
      alias /var/www/uploads/$upload_asset;
      add_header Content-Disposition "attachment" always;
      add_header X-Content-Type-Options "nosniff" always;
      access_log off;
      expires 30d;
    }

    location /uploads/ {
      alias /var/www/uploads/;
      access_log off;
      expires 30d;
      add_header Cache-Control "public, max-age=2592000, immutable";
      try_files $uri =404;
    }

    location ^~ /_next/static/ {
      proxy_pass http://frontend_upstream;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-Port 443;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      access_log off;
      expires 30d;
      add_header Cache-Control "public, max-age=2592000, immutable";
    }

    location ^~ /images/ {
      proxy_pass http://frontend_upstream;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-Port 443;
      proxy_set_header X-Forwarded-Proto $scheme;
      access_log off;
      expires 7d;
      add_header Cache-Control "public, max-age=604800";
    }

    location / {
      proxy_pass http://frontend_upstream;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-Port 443;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
    }
  }

  server {
    listen 443 ssl;
    http2 on;
    server_name ${ADMIN_DOMAIN};
    access_log /var/log/nginx/admin.access.json analytics_json;

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    # Enforce a conservative baseline while allowing the current Vite bundle
    # script/style requirements. Tighten unsafe-inline/unsafe-eval after report
    # telemetry confirms the runtime no longer needs them.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://www.jssngyl.cn https://admin.jssngyl.cn; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests" always;

    location ^~ /api/admin/ {
      proxy_pass http://backend_upstream;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /api/svc/ {
      return 404;
    }

    location /api/ {
      return 403;
    }

    # Force svg/pdf to download (never render inline) so a stored file cannot
    # execute script in the user's origin. Regex locations are matched before
    # the /uploads/ prefix, so raster images below stay inline as before.
    location ~* ^/uploads/(?<upload_asset>.+\.(?:svg|pdf))$ {
      alias /var/www/uploads/$upload_asset;
      add_header Content-Disposition "attachment" always;
      add_header X-Content-Type-Options "nosniff" always;
      access_log off;
      expires 30d;
    }

    location /uploads/ {
      alias /var/www/uploads/;
      access_log off;
      expires 30d;
      add_header Cache-Control "public, max-age=2592000, immutable";
      try_files $uri =404;
    }

    location / {
      proxy_pass http://admin_upstream;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }
  }
}
