      return 301 https://www.jssngyl.cn$legacy_product_path;
    }

    location = /product/product.php {
      return 301 /zh/products;
    }

    location = /news/shownews.php {
      return 301 https://www.jssngyl.cn$legacy_news_path;
    }

    location = /news/news.php {
      return 301 /zh/news;
    }

