NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
DATABASE_URL=postgresql://corporate:corporate@localhost:5432/corporate_site?schema=public
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
PUBLIC_SITE_URL=https://www.jssngyl.cn
BAIDU_SITE=www.jssngyl.cn
# 百度新文章报送与旧文补报默认暂停，只有字面 automatic 才允许发送。
BAIDU_TOKEN=
BAIDU_SUBMISSION_MODE=manual
# 默认加密连接；只有取得明文传输密钥的明确授权后才能设为字面 true。
BAIDU_ALLOW_HTTP=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
UPLOAD_ROOT=uploads
UPLOAD_MAX_FILE_SIZE_MB=10
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCK_MINUTES=15
SHUJU_SERVICE_ENABLED=false
SHUJU_SERVICE_JWT_SECRET=
SHUJU_NEWS_PUBLISH_ENABLED=false
SHUJU_NEWS_PUBLISH_JWT_SECRET=
SHUJU_INQUIRY_READ_ENABLED=false
SHUJU_INQUIRY_READ_JWT_SECRET=
SHUJU_INQUIRY_READ_MIN_ID=0
# 启用读取前必须改为生产库当时的最大 CustomRequirement ID；启用状态不接受 0。
SHUJU_GROWTH_READ_ENABLED=false
SHUJU_GROWTH_READ_JWT_SECRET=
# 只读取不含联系方式的官网访问、来源、页面和表单汇总。
